# Template: scripts/update.sh fills in @USER@, @CORE@ and @DATA@ and copies it to /etc/systemd/system/
[Unit]
Description=Doce Canciones brain (backend + webapp on port 8000)
After=network-online.target mosquitto.service
Wants=network-online.target
# never give up restarting it
StartLimitIntervalSec=0

[Service]
User=@USER@
WorkingDirectory=@CORE@/backend
Environment=DOCE_DATA=@DATA@
Environment=PYTHONUNBUFFERED=1
# every IPv6 and IPv4 address, so other computers reach it however they ask (IPv4 only if IPv6 is off)
ExecStart=@CORE@/backend/.venv/bin/python run.py 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
