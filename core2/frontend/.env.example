# Copy to .env.local if you need either of these; normally neither is needed.

# `pnpm dev`: the backend that /api and /ws are forwarded to (default http://127.0.0.1:8000).
# E.g. to work on the page on a laptop against the backend running on the NUC:
# VITE_BACKEND=http://nuc.local:8000

# Talk to a backend at another address directly instead of the one the page came from.
# VITE_API_BASE=http://nuc.local:8000
