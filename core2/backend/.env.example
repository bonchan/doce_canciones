# MQTT Broker Settings
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Base URL of the standalone file_server/server.py (run that permanently
# on the NUC — see its own docstring for why file hosting is a separate
# process from this backend). Defaults to localhost:8090 for running both
# on the same machine; override if the file server lives elsewhere, e.g.
# AUDIO_SERVER_URL=http://nuc.local:8090
AUDIO_SERVER_URL=http://127.0.0.1:8090

# Required header X-API-Key on POST /api/devices/... endpoints.
# Leave unset only for local testing on a trusted machine.
API_KEY=changeme

# Seconds of total silence (no status/announce/telemetry) before a device
# is force-marked offline, as a backup to the MQTT LWT.
STALE_TIMEOUT=15

# Seconds between MQTT connect attempts if the broker isn't reachable yet
# (or drops entirely) at startup.
MQTT_RETRY_DELAY=3

# Optional — mirrors the registry to Firebase Realtime Database for viewing
# the installation status from outside the gallery. Leave both unset to
# disable Firebase sync entirely (a warning is logged on startup, nothing
# else breaks). Path is relative to this backend/ directory.
FIREBASE_CRED_PATH=firebase/your-service-account.json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/
FIREBASE_INTERVAL_SECONDS=60

# Installation location, for the polargraph's "draw solar line" feature.
# Defaults to Neuquén — override if the installation moves.
SOLAR_LAT=-38.9516
SOLAR_LON=-68.0591
SOLAR_TZ=America/Argentina/Salta
