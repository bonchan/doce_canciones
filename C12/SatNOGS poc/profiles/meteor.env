# METEOR-M2-3 / M2-4 LRPT: digital signal, the recording is just noise
# -> only the images the stations decoded, no audio.
NORAD_IDS=57166,59051

# only these SatNOGS station ids (empty = all stations)
STATION_IDS=

# --- "is there something in it" filters ---
# empty = any transmitter. Once a saved observation.json shows the image mode
# (its "mode" field, probably LRPT) put it here: fewer pages to fetch
MODES=
MIN_ELEVATION=30
REQUIRE_SIGNAL=0
# only download station images whose name ends with one of these (comma separated,
# before the extension): data_15105291_msu_mr_rgb_MCIR_map.png -> MCIR_map. Empty = all
IMAGES=MCIR_map
# at least one of those images, or the pass is skipped
MIN_STATION_IMAGES=1
AUDIO_ONLY=no

DOWNLOAD_IMAGES=1
DOWNLOAD_AUDIO=0

# --- station variety, counted from what's already in downloads/ ---
MAX_PER_STATION=3
MAX_PER_WINDOW=3
MAX_PASSES=100

# --- dates (UTC) ---
# still transmitting: walk back from today. progress in downloads/progress_meteor.json
BACKWARDS_FROM=now
BACKWARDS_TO=2024-03-01
WINDOW_HOURS=24
