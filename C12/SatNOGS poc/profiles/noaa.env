# NOAA 15 / 18 / 19 APT: recording (.ogg) + images.
# They stopped transmitting in mid 2025, so the walk starts there and goes back.
NORAD_IDS=25338,28654,33591

# only these SatNOGS station ids (empty = all stations)
STATION_IDS=

# --- "is there something in it" filters ---
MODES=APT
# min max-elevation of the pass in degrees - higher passes = stronger signal
MIN_ELEVATION=30
# 1 = waterfall vetted as "with-signal" (for every pass)
REQUIRE_SIGNAL=0
# only download station images whose name ends with one of these (comma separated,
# before the extension), e.g. MCIR,MSA. Empty = all of them
IMAGES=
# passes with at least this many station images (MCIR, MSA, ...) are always kept
MIN_STATION_IMAGES=2
# passes with fewer: no = skip, signal = keep if vetted "with-signal", any = keep.
# kept ones get their image decoded here from the .ogg (DECODE_APT in .env)
AUDIO_ONLY=signal

DOWNLOAD_IMAGES=1
DOWNLOAD_AUDIO=1

# --- station variety, counted from what's already in downloads/ ---
# passes per ground station (0 = no limit)
MAX_PER_STATION=3
# passes per satellite per window: spreads the passes over more days (0 = no limit)
MAX_PER_WINDOW=3
# stop this profile (and its requests) at this many NOAA passes on disk (0 = no limit)
MAX_PASSES=200

# --- dates (UTC) ---
# progress in downloads/progress_noaa.json - a restart resumes there
BACKWARDS_FROM=2025-09-01
BACKWARDS_TO=2015-01-01
WINDOW_HOURS=24
